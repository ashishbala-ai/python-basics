mat=[]
r1=int(input("enter the number of rows"))
c1=int(input("enter the number of coloum"))
for i in range (r1):
    sun=[]
    for j in range (c1):
        u=int(input("enter the values"))
        sun.append(u)
    mat.append(sun)
print(mat)
for i in mat:
    for j in i:
        print(j,end=" ")
    print()
transpose=[]
for j in range(c1):
    row=[]
    for i in range(r1):
        row.append(mat[i][j])
    transpose.append(row)
for i in transpose:
    for j in i:
        print(j,end=" ")
    print()